{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.13.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/toolbar_unavailable_16.png",
      "32": "icons/toolbar_unavailable_32.png",
      "48": "icons/toolbar_unavailable_48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "delete-queue.js",
        "i18n.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ]
}
